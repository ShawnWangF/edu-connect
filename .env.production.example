# Copy this file to .env.production on the server, then update secrets and domain.

APP_ID=edu-connect
APP_DOMAIN=hkeiu.example.internal
PUBLIC_BASE_URL=https://hkeiu.example.internal
JWT_SECRET=replace-with-a-long-random-secret

MYSQL_DATABASE=edu_connect
MYSQL_USER=edu_connect
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
DATABASE_URL=mysql://edu_connect:replace-with-a-strong-password@mysql:3306/edu_connect

OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1

GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VITE_VAPID_PUBLIC_KEY=

NOTIFICATION_API_URL=
NOTIFICATION_API_KEY=

DATA_API_URL=
DATA_API_KEY=
