# App
NODE_ENV=development
PORT=3000
APP_ID=edu-connect
PUBLIC_BASE_URL=http://localhost:3000
JWT_SECRET=change-this-to-a-long-random-string

# Database (MySQL)
DATABASE_URL=mysql://edu_connect:edu_connect_password@127.0.0.1:3306/edu_connect

# Optional OpenAI-compatible AI features
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1

# File storage
# Default is local ./uploads served from /uploads.
FILE_STORAGE_DIR=uploads

# Optional S3/R2-compatible storage. Leave S3_BUCKET empty to use local storage.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=

# Optional Google Maps
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_URL=https://maps.googleapis.com
VITE_GOOGLE_MAPS_API_URL=https://maps.googleapis.com

# Optional Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VITE_VAPID_PUBLIC_KEY=

# Optional owner notification webhook
NOTIFICATION_API_URL=
NOTIFICATION_API_KEY=

# Optional external Data API base
DATA_API_URL=
DATA_API_KEY=
